{
  "name": "nymh-vpm",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/listing-data.mjs && vite --host 127.0.0.1",
