  },
  "dependencies": {
    "semver": "^7.8.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.11"
  }
}
